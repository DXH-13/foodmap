# Mẫu biến môi trường cho FoodMap.
# Copy thành infra/.env rồi điền giá trị thật. KHÔNG commit file .env.
#
#   cp infra/.env.example infra/.env

# Ghi chú về cổng: FoodMap dùng cổng lệch chuẩn (5433, 6380, 9002/9003) để không
# đụng các dịch vụ Postgres/Redis/MinIO khác có thể đang chạy trên máy bạn.
# Máy bạn chắc chắn trống cổng chuẩn thì cứ đổi lại, chúng đều là biến.

# ─────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=foodmap
POSTGRES_USER=foodmap
POSTGRES_PASSWORD=foodmap
POSTGRES_PORT=5433

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_PORT=6380

# ─────────────────────────────────────────────────────────────
# MinIO (S3-compatible) — lưu ảnh và video review
# Ở production thay bằng endpoint và credential của S3 thật.
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=foodmap-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true

# ─────────────────────────────────────────────────────────────
# Mailpit — hộp thư giả cho dev, không email nào thoát ra ngoài
# ─────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@foodmap.local

# ─────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ⚠️ ĐỔI GIÁ TRỊ NÀY. Tối thiểu 32 ký tự ngẫu nhiên.
#    Sinh nhanh: openssl rand -base64 48
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
# Dịch vụ ngoài — BẮT BUỘC điền, không có giá trị mặc định dùng được
# ─────────────────────────────────────────────────────────────

# Google Maps: cần bật Maps SDK for Android, Maps SDK for iOS,
# Geocoding API và Places API trong Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Claude API cho chatbot. Lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Expo Push — để trống thì dùng kênh không xác thực (đủ cho dev)
EXPO_ACCESS_TOKEN=

# Google Stitch — chỉ cho Cursor MCP sinh UI, không dùng trong docker.
# Tạo key: stitch.withgoogle.com → Stitch settings → API key
# Gán User env Windows: setx STITCH_API_KEY "..." rồi restart Cursor.
# Không commit key thật. Cursor đọc biến môi trường, không đọc file này.
STITCH_API_KEY=

# ─────────────────────────────────────────────────────────────
# Client
# ─────────────────────────────────────────────────────────────
# Mobile: dùng IP LAN của máy, KHÔNG dùng localhost — thiết bị thật
# và máy ảo Android không hiểu localhost của máy bạn.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
